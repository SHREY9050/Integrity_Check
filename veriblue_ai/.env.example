# VeriBlue AI - API Credentials Template
# All 3 APIs below have 100% FREE tiers (no payment needed)

# 1. VirusTotal v3 API Key (Free tier: 500 requests/day at https://www.virustotal.com/)
VIRUSTOTAL_API_KEY=

# 2. Tavily Search API Key (Free tier: 1000 searches/mo at https://tavily.com/)
TAVILY_API_KEY=

# 3. Google Gemini API Key (100% FREE at https://aistudio.google.com/)
GEMINI_API_KEY=

# 4. Optional: OpenAI API Key (if you prefer OpenAI over Gemini)
OPENAI_API_KEY=

# AI Provider: 'gemini' (Free) or 'openai'
AI_PROVIDER=gemini

# Model: gemini-2.5-flash or gemini-1.5-flash (for Gemini); gpt-4o-mini (for OpenAI)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.0
